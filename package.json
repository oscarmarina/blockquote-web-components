{
  "name": "blockquote-web-components",
  "version": "2.21.1",
  "private": true,
  "description": "Monorepo - Blockquote Web Components - A modern architecture for building composable and reusable Web Components",
  "homepage": "https://github.com/oscarmarina/blockquote-web-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarmarina/blockquote-web-components"
  },
  "author": {
    "name": "oscarmarina",
    "url": "https://62d3439a0eebee66a69d4650--adorable-macaron-7c1b61.netlify.app"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/**/*"
    ]
  },
  "scripts": {
    "analyze": "lerna run analyze --stream --concurrency 1",
    "build": "lerna run build",
    "clean": "rm package-lock.json && lerna clean",
    "clean:packages": "lerna exec -- rm -rf ./node_modules && npm run clean:packages:dev && npm run clean:packages:dist && npm run clean:packages:coverage",
    "clean:packages:coverage": "lerna exec -- rm -rf ./test/coverage",
    "clean:packages:dev": "lerna exec -- rm -rf ./dev && lerna exec -- rm -rf ./package-lock.json",
    "clean:packages:dist": "lerna exec -- rm -rf ./dist && lerna exec -- rm -rf ./package-lock.json",
    "format": "lerna run format --stream --concurrency 1",
    "prepare": "husky",
    "push": "git push --follow-tags origin main",
    "release": " npm ci && npm run test:pre-push && lerna version --no-push",
    "site": "npm run site:prepare && npm run site:copy",
    "site:copy": "rm -rf ./site/**/* && node scripts/move-dev-directory.js",
    "site:prepare": "npm run clean:packages:dev && lerna run build:demo",
    "sort:package": "lerna run sort:package",
    "standard": "commit-and-tag-version",
    "test": "lerna run test --stream --concurrency 1 -- --run",
    "test:pre-push": "lerna run test --stream --concurrency 1 --since origin/main -- --run",
    "test:scope": "func() { lerna run test --stream --concurrency 1 --scope @blockquote-web-components/${1}; }; func",
    "postversion": "npm run standard"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "@commitlint/config-workspace-scopes"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        150
      ]
    }
  },
  "prettier": {
    "bracketSameLine": true,
    "bracketSpacing": false,
    "htmlWhitespaceSensitivity": "ignore",
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "*.{scss,css}",
        "options": {
          "singleQuote": false
        }
      },
      {
        "files": "*.json",
        "options": {
          "parser": "json-stringify"
        }
      }
    ]
  },
  "stylelint": {
    "extends": "stylelint-config-standard-scss",
    "allowEmptyInput": true,
    "rules": {
      "custom-property-pattern": null,
      "no-duplicate-selectors": null,
      "color-function-notation": null,
      "alpha-value-notation": null,
      "media-feature-name-no-unknown": null,
      "comment-empty-line-before": null,
      "declaration-empty-line-before": null,
      "property-no-vendor-prefix": null,
      "selector-attribute-quotes": null,
      "value-no-vendor-prefix": null
    },
    "overrides": [
      {
        "files": [
          "**/*.html"
        ],
        "customSyntax": "postcss-html"
      },
      {
        "files": [
          "**/*.{ts,js}"
        ],
        "customSyntax": "postcss-lit"
      }
    ]
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "glob": "^13.0.6",
    "js-yaml": "^5.3.0",
    "tar": "^7.5.22"
  },
  "dependencies": {
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/eslint-plugin": "^8.0.1",
    "@blockquote/cem-to-markdown-readme": "^1.0.0",
    "@blockquote/coverage-table-reporter": "^1.2.0",
    "@blockquote/eslint-config": "^0.1.1",
    "@blockquote/rollup-plugin-total-bundlesize": "^2.4.0",
    "@blockquote/sass-style-template": "^5.2.0",
    "@blockquote/vite-plugin-prevent-rewrite-imports-type-module": "^0.1.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/config-workspace-scopes": "^21.2.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@open-wc/semantic-dom-diff": "^0.21.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@rollup/plugin-multi-entry": "^7.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^5.0.0-rc.1",
    "@vitest/coverage-istanbul": "^5.0.0-rc.1",
    "@vitest/coverage-v8": "^5.0.0-rc.1",
    "@vitest/ui": "^5.0.0-rc.1",
    "chai-a11y-axe": "^1.5.0",
    "commit-and-tag-version": "^13.1.2",
    "concurrently": "^10.0.5",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "lit-html": "^3.3.3",
    "nise": "^6.1.5",
    "nx": "^23.1.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-html": "2.0.0",
    "postcss-lit": "1.4.1",
    "prettier": "^3.9.6",
    "rollup-plugin-node-externals": "^9.0.1",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "tinyglobby": "^0.2.17",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.0-rc.1"
  },
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "chore: release {{currentTag}}",
    "commitUrlFormat": "{{host}}/oscarmarina/blockquote-web-components/commit/{{hash}}",
    "compareUrlFormat": "{{host}}/oscarmarina/blockquote-web-components/compare/{{previousTag}}...{{currentTag}}"
  }
}
